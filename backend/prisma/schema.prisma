datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Customer {
  id        String         @id @default(uuid())
  name      String
  email     String         @unique
  createdAt DateTime       @default(now())
  cards     CustomerCard[]

  @@map("customers")
}

model CustomerCard {
  id          String   @id @default(uuid())
  card_number String   @unique
  card_type   String
  customer_id String
  issued_on   DateTime @default(now())
  limit       Float    @default(5000.0)

  customer Customer @relation(fields: [customer_id], references: [id], onDelete: Cascade)

  @@map("customer_cards")
}
